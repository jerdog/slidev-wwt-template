{
  "name": "slidev-theme-wwt",
  "version": "0.3.0",
  "description": "WWT-branded theme for Slidev",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev",
    "wwt"
  ],
  "files": [
    "layouts/",
    "components/",
    "styles/",
    "setup/",
    "public/",
    "env.d.ts",
    "package.json",
    "README.md"
  ],
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter starter dev",
    "build": "pnpm --filter starter build",
    "export": "pnpm --filter starter export",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,vue,css,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,md,json,yaml,yml}\"",
    "typecheck": "vue-tsc --noEmit && pnpm --filter starter typecheck",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@slidev/cli": ">=0.49.0",
    "@slidev/types": ">=0.49.0",
    "vue": ">=3.4.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@formkit/auto-animate": "^0.9.0"
  },
  "devDependencies": {
    "@slidev/cli": "^0.49.0",
    "@slidev/types": "^0.49.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "happy-dom": "^15.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "vue": "^3.5.12",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  }
}
